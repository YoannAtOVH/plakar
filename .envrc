# direnv (https://direnv.net) environment for this checkout.
# Run `direnv allow` once; direnv reloads it whenever it changes.
#
# plakar itself needs nothing from here -- everything below configures the
# containerised plugin packaging described in packaging/ptar/README.md, so that
# `make ptar` works on a machine with docker and no Go toolchain at all.

# plakar-ptar, the docker wrapper.
PATH_add packaging/ptar/bin

# Where the .ptar packages and their checksums land.  Absolute, so the wrapper
# and `docker compose run` agree on it from any subdirectory.  Ignored by git
# through /dist.
export PTAR_DIST="${PTAR_DIST:-$(expand_path ./dist/plugins)}"
mkdir -p "$PTAR_DIST"

# Builder image and its Go base.  The floor is Go 1.26.2, required by the
# webdav connector's go.mod; GOTOOLCHAIN is pinned to `local` in the image, so
# a plugin asking for more fails the build instead of downloading a toolchain.
export PTAR_GO_IMAGE="${PTAR_GO_IMAGE:-golang:1.26.5-alpine3.23}"
export PTAR_IMAGE="${PTAR_IMAGE:-plakar-ptar-builder:local}"

# Targets to package, space separated "os/arch".  The plugins are plain Go, so
# one amd64 container cross compiles every one of them; add more at will, e.g.
#   export PTAR_PLATFORMS="linux/amd64 linux/arm64 darwin/arm64 windows/amd64"
export PTAR_PLATFORMS="${PTAR_PLATFORMS:-linux/amd64}"

# The builder runs as root inside the container and hands the artifacts back to
# this uid:gid on the way out, so /dist does not end up root owned.
export PTAR_OWNER="$(id -u):$(id -g)"

export DOCKER_BUILDKIT=1

# Untracked overrides: PLAKAR_CLONE_TOKEN for private plugin repositories,
# PTAR_S3_VERSION / PTAR_WEBDAV_VERSION to package a tag other than the one the
# recipe pins, ...  See .env.example.
dotenv_if_exists .env

log_status "ptar: platforms [$PTAR_PLATFORMS] -> $PTAR_DIST"
