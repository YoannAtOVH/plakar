# Copy to .env (untracked) to override the defaults from .envrc.
# direnv loads it through dotenv_if_exists, so no export keyword and no shell
# expansion here -- plain KEY=value lines only.

# Package a different tag than the one pinned in packaging/ptar/recipes/.
#PTAR_S3_VERSION=v1.1.1
#PTAR_WEBDAV_VERSION=webdav/v1.1.0-alpha.2

# Cross build for more than the host platform.  Quote it: the value has spaces.
#PTAR_PLATFORMS="linux/amd64 linux/arm64 darwin/arm64 windows/amd64"

# Token `plakar pkg build` uses to clone private plugin repositories.
#PLAKAR_CLONE_TOKEN=
